{
  "name": "sisp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SISP — Student Information and Services Portal monorepo",
  "scripts": {
    "dev:frontend": "cd sisp-frontend && npm run dev",
    "dev:backend": "cd sisp-backend && npm run start:dev",
