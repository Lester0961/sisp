# SISP ML service local-development template.
# Copy this file to .env and replace placeholders through a private channel.

PORT=8000
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
GROQ_API_KEY=<groq-api-key>
GOOGLE_AI_API_KEY=<google-ai-studio-api-key>
OPENROUTER_API_KEY=<openrouter-api-key>
GROQ_MODEL=qwen/qwen3.6-27b
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_MODEL=openrouter/free
LLM_PROVIDER_ORDER=groq,gemini,openrouter
LLM_REQUEST_TIMEOUT_SECONDS=18
LLM_MAX_TOKENS=900
GROQ_ENABLED=true
GEMINI_ENABLED=true
OPENROUTER_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CONFIDENCE_THRESHOLD=0.65
ADVISORY_SUPPORTED_LANGUAGES=en,fil,ceb,ilo,hil,war
