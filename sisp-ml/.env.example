# Copy to .env.local for local-only credentials.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_ENABLED=true
NVIDIA_REQUEST_TIMEOUT_SECONDS=35
LLM_PROVIDER_ORDER=nvidia
LLM_MAX_TOKENS=280
MULTILINGUAL_QUERY_REWRITE_ENABLED=false
MULTILINGUAL_QUERY_REWRITE_MIN_SIMILARITY=0.5
DENSE_RETRIEVAL_ENABLED=true
GROQ_ENABLED=false
GEMINI_ENABLED=false
OPENROUTER_ENABLED=false
