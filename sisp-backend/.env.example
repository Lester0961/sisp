# ================================
# APPLICATION
# ================================
PORT=3001
NODE_ENV=development

# ================================
# DATABASE (Supabase + Prisma)
# ================================
# Option 1: Use the shared Supabase DB (ask Lester for credentials)
# Option 2: Leave these empty/invalid to auto-enable MOCK MODE (no DB needed for local dev)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# ================================
# SUPABASE
# ================================
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ================================
# JWT
# ================================
# Generate strong secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-a-64-byte-hex-secret-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="generate-a-different-64-byte-hex-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"

# ================================
# FRONTEND
# ================================
FRONTEND_URL="http://localhost:3000"

# ================================
# BREVO EMAIL API (for MFA OTP emails)
# ================================
BREVO_API_KEY="your-brevo-api-key-here"

# ================================
# ML SERVICE (optional — ARIA works without it)
# ================================
ML_SERVICE_URL="http://localhost:8000"
