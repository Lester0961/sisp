# SISP backend local-development template.
# Copy this file to .env and replace every placeholder before using a real service.

PORT=3001
NODE_ENV=development
MFA_ENABLED=false
MFA_OTP_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5
MFA_LOG_OTP=false
LOCAL_DEMO_PASSWORD=local-demo-only

# Use local PostgreSQL or obtain shared credentials through a private channel.
# Development only: an unavailable database enables the in-memory mock store.
# Production refuses to start unless the real database is reachable.
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>
DIRECT_URL=postgresql://<username>:<password>@<host>:5432/<database>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<never-commit-service-role-key>

# Generate both secrets locally; never copy production values into this file.
JWT_SECRET=<random-jwt-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<random-refresh-secret>
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Phase 1 MFA policy: comma-separated institutional roles that must complete
# an email OTP challenge (use "none" to disable MFA).
MFA_REQUIRED_ROLES=sys_admin,dean,registrar,treasury
MFA_OTP_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5

# Phase 1 identity verification uploads (private storage directory).
# Defaults to <backend>/storage/identity when unset.
IDENTITY_STORAGE_DIR=
# Private Supabase Storage bucket used in production (free tier).
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, uploads go to this
# bucket and reviewers receive short-lived signed URLs instead of local files.
IDENTITY_STORAGE_BUCKET=identity-documents

FRONTEND_URL=http://localhost:3002
ADDITIONAL_CORS_ORIGINS=http://localhost:3014

# Required only when MFA email delivery is enabled.
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<verified-sender-email>
BREVO_SENDER_NAME=SISP | Regis Marie College

# Use RATE_LIMIT_PROFILE=test only for a controlled local smoke test.
RATE_LIMIT_PROFILE=production

# ARIA ML service. Required in production (startup validation enforces this);
# ARIA falls back to escalation when the service is unavailable.
ML_SERVICE_URL=http://localhost:8000
ML_SECRET_TOKEN=<shared-ml-service-secret>

# Treasury payment channels (P6-04). Values are institutional configuration,
# never committed. Leave blank when not officially configured; the API then
# instructs students to contact the Treasury Office.
PAYMENT_CHANNEL_GCASH_NUMBER=
PAYMENT_CHANNEL_GCASH_NAME=
PAYMENT_CHANNEL_GCASH_NOTE=
PAYMENT_CHANNEL_PNB_ACCOUNT=
PAYMENT_CHANNEL_PNB_NAME=
PAYMENT_PROOF_RECIPIENT_NAME=
PAYMENT_PROOF_RECIPIENT_OFFICE=
PAYMENT_PROOF_RECIPIENT_INSTRUCTION=
