generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// RBAC
// ============================================================

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  action    String
  resource  String
  roles     RolePermission[]
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// USERS
// ============================================================

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  firstName          String   @default("") @map("first_name")
  lastName           String   @default("") @map("last_name")
  roleId             String   @map("role_id")
  role               Role     @relation(fields: [roleId], references: [id])
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  studentProfile    StudentProfile?
  auditLogs         AuditLog[]
  taughtEnrollments Enrollment[]    @relation("FacultyEnrollments")

  notifications  Notification[]
  escalations    EscalationQueue[]
  chatLogs       ChatLog[]
  chatDailyUsage ChatDailyUsage[]

  // Phase 1 identity/session records
  authSessions          AuthSession[]
  mfaChallenges         MfaChallenge[]
  passwordResetTokens   PasswordResetToken[]
  reviewedVerifications StudentIdentityVerification[] @relation("IdentityReviewedBy")
  reviewedVerificationDocuments IdentityVerificationDocument[] @relation("VerificationDocumentReviewedBy")

  // Grade workflow relations
  submittedGrades Grade[] @relation("GradeSubmittedBy")
  postedGrades    Grade[] @relation("GradePostedBy")
  approvedGrades  Grade[] @relation("GradeApprovedBy")
  rejectedGrades  Grade[] @relation("GradeRejectedBy")

  // Payment confirmation
  confirmedPayments DocumentRequest[] @relation("PaymentConfirmedBy")
  confirmedTorQuotes DocumentRequest[] @relation("TorQuoteConfirmedBy")

  // Live agent sessions
  assignedChatSessions ChatSession[] @relation("SessionAssignedTo")
  sentChatMessages     ChatMessage[]

  // Phase 3 supporting structures
  instructedSections     ClassSection[]        @relation("SectionInstructor")
  paymentVerifications   PaymentTransaction[]  @relation("PaymentVerifiedBy")
  adviserAssignments     AdviserAssignment[]   @relation("AdviserAssignments")
  advisingConcerns       AdvisingConcern[]     @relation("ConcernAdviser")
  enrollmentHistoryChanges EnrollmentHistory[] @relation("HistoryChangedBy")

  @@map("users")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  // Nullable + SetNull: audit history survives account removal/deactivation.
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String?  @map("actor_email")
  actorRole  String?  @map("actor_role")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  // Optional transition snapshot for status/workflow changes (P7-04).
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ============================================================
// ACADEMIC — PROGRAMS
// ============================================================

model Program {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  curricula             Curriculum[]
  studentProfiles       StudentProfile[]
  admissionApplications AdmissionApplication[]

  @@map("programs")
}

// ============================================================
// STUDENT PROFILE
// ============================================================

model StudentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  studentNumber String   @unique @map("student_number")
  programId     String   @map("program_id")
  program       Program  @relation(fields: [programId], references: [id])
  yearLevel     Int      @map("year_level")
  lifecycleStatus String @default("active") @map("lifecycle_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  curriculumId  String?  @map("curriculum_id")
  curriculum    Curriculum? @relation(fields: [curriculumId], references: [id])

  enrollments       Enrollment[]
  enrollmentHistory EnrollmentHistory[]
  accountBalance    AccountBalance?
  documentRequests  DocumentRequest[]
  studentSemesters  StudentSemester[]
  chatSessions      ChatSession[]
  admissionApplication AdmissionApplication?
  identityVerifications StudentIdentityVerification[] @relation("MatchedStudentProfile")

  // Phase 3 supporting structures
  paymentTransactions PaymentTransaction[]
  adviserAssignments  AdviserAssignment[]
  advisingConcerns    AdvisingConcern[]

  @@map("student_profiles")
}

// ============================================================
// ACADEMIC TERMS (Trisemestral calendar)
// ============================================================

model AcademicTerm {
  id           String    @id @default(uuid())
  academicYear String    @map("academic_year")
  termNumber   Int       @map("term_number")
  code         String    @unique // e.g. 2026-2027-T1
  label        String // e.g. Term 1
  startsOn     DateTime? @map("starts_on") @db.Date
  endsOn       DateTime? @map("ends_on") @db.Date
  status       String    @default("planned") // planned | active | closed
  isCurrent    Boolean   @default(false) @map("is_current")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  studentSemesters StudentSemester[]
  enrollments      Enrollment[]

  // Phase 3 supporting structures
  classSections       ClassSection[]
  paymentTransactions PaymentTransaction[]
  adviserAssignments  AdviserAssignment[]
  enrollmentHistory   EnrollmentHistory[]

  @@unique([academicYear, termNumber])
  @@index([academicYear, termNumber])
  @@map("academic_terms")
}

// ============================================================
// STUDENT TERMS (Payment tracking; legacy table retained)
// ============================================================

model StudentSemester {
  id               String         @id @default(uuid())
  studentId        String         @map("student_id")
  student          StudentProfile @relation(fields: [studentId], references: [id])
  termId           String?        @map("term_id")
  term             AcademicTerm?  @relation(fields: [termId], references: [id])
  semester         String // e.g., "1st", "2nd", "Summer"
  year             String // e.g., "2025-2026"
  isFullyPaid      Boolean        @default(false) @map("is_fully_paid")
  paymentStatus    String         @default("unpaid") @map("payment_status") // unpaid | partial | paid | waived
  amountDue        Decimal?       @map("amount_due") @db.Decimal(10, 2)
  amountPaid       Decimal?       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  paidAt           DateTime?      @map("paid_at")
  paymentReference String?        @map("payment_reference")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([studentId, semester, year])
  @@map("student_semesters")
}

// ============================================================
// COURSES & CURRICULUM
// ============================================================

model Course {
  id          String   @id @default(uuid())
  code        String
  isCodeSynthesized Boolean @default(false) @map("is_code_synthesized")
  title       String
  units       Int
  lecUnits    Int      @default(0) @map("lec_units")
  labUnits    Int?     @default(0) @map("lab_units")
  subjectArea String?  @map("subject_area")
  catNo       String?  @map("cat_no")
  // Raw prerequisite text from source doc (e.g. "MMA101", "ITE 6200A, CS 6201A", "—"/"-").
  // Never silently corrected; see CoursePrerequisite for resolved links.
  prereqText  String?  @map("prereq_text")
  createdAt   DateTime @default(now()) @map("created_at")

  curriculumCourses CurriculumCourse[]
  enrollments       Enrollment[]
  prerequisites     CoursePrerequisite[] @relation("CoursePrereqs")
  requiredBy        CoursePrerequisite[] @relation("PrereqRequiredBy")
  classSections     ClassSection[]
  enrollmentHistory EnrollmentHistory[]

  @@unique([code, title])
  @@index([code])
  @@map("courses")
}

// Resolved prerequisite links. requiresId is null when the code is not
// resolvable within the same curriculum (cross-program ref, typo preserved
// from source, or self-reference anomaly from verification notes §10).
model CoursePrerequisite {
  id              String  @id @default(uuid())
  courseId        String  @map("course_id")
  course          Course  @relation("CoursePrereqs", fields: [courseId], references: [id], onDelete: Cascade)
  requiresCode    String  @map("requires_code")
  requiresId      String? @map("requires_id")
  requires        Course? @relation("PrereqRequiredBy", fields: [requiresId], references: [id], onDelete: SetNull)
  isSelfReference Boolean @default(false) @map("is_self_reference")
  isUnresolved    Boolean @default(false) @map("is_unresolved")
  note            String?

  @@unique([courseId, requiresCode])
  @@index([courseId])
  @@map("course_prerequisites")
}

model Curriculum {
  id            String   @id @default(uuid())
  programId     String   @map("program_id")
  program       Program  @relation(fields: [programId], references: [id])
  effectiveYear Int      @map("effective_year")
  schoolYear    String?  @map("school_year")
  cmo           String?  @map("cmo")
  sourceFile    String?  @map("source_file")
  createdAt     DateTime @default(now()) @map("created_at")

  curriculumCourses CurriculumCourse[]
  studentProfiles   StudentProfile[]

  @@unique([programId, effectiveYear])
  @@map("curricula")
}

// ============================================================
// ADMISSION MODULE — Applications & Requirements
// ============================================================

model AdmissionApplication {
  id              String   @id @default(uuid())
  applicationNo   String   @unique @map("application_no")
  applicantType   String   @map("applicant_type") // freshman | transferee | bridging | cross_enrollee
  status          String   @default("draft") // draft | submitted | under_review | needs_revision | approved | rejected | withdrawn
  
  // Personal Info
  firstName       String   @map("first_name")
  middleName      String?  @map("middle_name")
  lastName        String   @map("last_name")
  suffix          String?
  dob             DateTime @db.Date
  sex             String?
  nationality     String?  @default("Filipino")
  
  // Contact Info
  email           String
  mobile          String
  addressLine     String   @map("address_line")
  city            String
  province        String
  postalCode      String?  @map("postal_code")
  
  // Guardian Info
  guardianName    String   @map("guardian_name")
  guardianRelation String  @map("guardian_relation")
  guardianContact String   @map("guardian_contact")
  
  // Emergency Contact
  emergencyName   String   @map("emergency_name")
  emergencyRelation String @map("emergency_relation")
  emergencyContact String  @map("emergency_contact")
  
  // Education Background
  lastSchoolName  String   @map("last_school_name")
  lastSchoolType  String?  @map("last_school_type") // jhs | shs | college
  yearGraduated   Int?     @map("year_graduated")
  previousProgram String?  @map("previous_program")
  strandTrack     String?  @map("strand_track")
  
  // Program Choice & Converted Student Link
  programId       String   @map("program_id")
  program         Program  @relation(fields: [programId], references: [id])
  createdStudentId String? @unique @map("created_student_id")
  createdStudent   StudentProfile? @relation(fields: [createdStudentId], references: [id])
  
  reviewNotes     String?  @map("review_notes")
  reviewedById    String?  @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at")
  
  requirements    AdmissionRequirementSubmission[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("admission_applications")
}

model AdmissionRequirementDefinition {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. FORM_137, GOOD_MORAL, PSA_BIRTH, ID_PHOTO, TRANSCRIPT
  title         String
  description   String?
  applicantType String?  @map("applicant_type") // null = all, or freshman/transferee/etc
  isRequired    Boolean  @default(true) @map("is_required")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")

  submissions   AdmissionRequirementSubmission[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("admission_requirement_definitions")
}

model AdmissionRequirementSubmission {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  definitionId  String   @map("definition_id")
  definition    AdmissionRequirementDefinition @relation(fields: [definitionId], references: [id])
  // Legacy public URL field retained for compatibility; secure uploads store
  // the private object key in storageObjectKey and leave this empty.
  fileUrl       String   @map("file_url")
  fileName      String   @map("file_name")
  fileSize      Int?     @map("file_size")
  mimeType      String?  @map("mime_type")
  storageObjectKey String? @map("storage_object_key")
  status        String   @default("submitted") // submitted | verified | rejected | resubmission_required
  reviewNotes   String?  @map("review_notes")
  reviewedByUserId String? @map("reviewed_by_user_id")
  reviewedAt    DateTime? @map("reviewed_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([applicationId, definitionId])
  @@map("admission_requirement_submissions")
}

model CurriculumCourse {
  curriculumId String     @map("curriculum_id")
  courseId     String     @map("course_id")
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  yearLevel    Int        @map("year_level")
  semester     Int
  termNumber   Int?       @map("term_number")
  termLabel    String?    @map("term_label")
  sourceUnits  Int        @map("source_units")
  sourceLecUnits Int      @map("source_lec_units")
  sourceLabUnits Int?     @map("source_lab_units")
  sourceTotal  String?    @map("source_total")

  @@id([curriculumId, courseId])
  @@index([curriculumId, yearLevel, termNumber])
  @@map("curriculum_courses")
}

// ============================================================
// ENROLLMENT
// ============================================================

model EnrollmentHistory {
  id        String         @id @default(uuid())
  studentId String         @map("student_id")
  student   StudentProfile @relation(fields: [studentId], references: [id])
  // Legacy term label retained for compatibility with the printed concept.
  term      String
  // Phase 3 enrichment (P3-03): structured references + transition audit.
  enrollmentId   String?        @map("enrollment_id")
  enrollment     Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  courseId       String?        @map("course_id")
  course         Course?        @relation(fields: [courseId], references: [id])
  academicTermId String?        @map("academic_term_id")
  academicTerm   AcademicTerm?  @relation(fields: [academicTermId], references: [id])
  academicYear   String?        @map("academic_year")
  previousStatus String?        @map("previous_status")
  status         String
  changedById    String?        @map("changed_by_id")
  changedBy      User?          @relation("HistoryChangedBy", fields: [changedById], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([studentId, createdAt])
  @@map("enrollment_history")
}

model Enrollment {
  id           String         @id @default(uuid())
  studentId    String         @map("student_id")
  student      StudentProfile @relation(fields: [studentId], references: [id])
  courseId     String         @map("course_id")
  course       Course         @relation(fields: [courseId], references: [id])
  section      String?
  status       String         @default("enrolled")
  termId       String?        @map("term_id")
  term         AcademicTerm?  @relation(fields: [termId], references: [id])
  semester     String? // e.g. "1st"
  year         String? // e.g. "2025-2026"
  instructorId String?        @map("instructor_id")
  instructor   User?          @relation("FacultyEnrollments", fields: [instructorId], references: [id])
  // Phase 3 (P3-04): gradual move from free-text section to a scheduled
  // section. Legacy `section` text is preserved until data is stable.
  classSectionId String?      @map("class_section_id")
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id])
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  grade   Grade?
  history EnrollmentHistory[]

  // One enrollment identity per student/course/term (P3-02).
  @@unique([studentId, courseId, termId])
  @@map("enrollments")
}

// ============================================================
// GRADES — with workflow status
// ============================================================

model Grade {
  id           String     @id @default(uuid())
  enrollmentId String     @unique @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  prelim       Float?
  midterm      Float?
  finals       Float?
  finalGrade   Float?     @map("final_grade")
  isVisible    Boolean    @default(false) @map("is_visible")

  // Workflow status
  status          String    @default("draft") // draft | submitted | posted | approved | rejected
  submittedById   String?   @map("submitted_by_id")
  submittedBy     User?     @relation("GradeSubmittedBy", fields: [submittedById], references: [id])
  submittedAt     DateTime? @map("submitted_at")
  postedById      String?   @map("posted_by_id")
  postedBy        User?     @relation("GradePostedBy", fields: [postedById], references: [id])
  postedAt        DateTime? @map("posted_at")
  approvedById    String?   @map("approved_by_id")
  approvedBy      User?     @relation("GradeApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime? @map("approved_at")
  rejectedById    String?   @map("rejected_by_id")
  rejectedBy      User?     @relation("GradeRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt      DateTime? @map("rejected_at")
  rejectedRemarks String?   @map("rejected_remarks")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("grades")
}

// ============================================================
// FINANCIAL
// ============================================================

model AccountBalance {
  id        String         @id @default(uuid())
  studentId String         @unique @map("student_id")
  student   StudentProfile @relation(fields: [studentId], references: [id])
  balance   Decimal        @db.Decimal(10, 2)
  status    String         @default("active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("account_balances")
}

// ============================================================
// DOCUMENT REQUESTS — with payment
// ============================================================

model DocumentRequest {
  id        String         @id @default(uuid())
  studentId String         @map("student_id")
  student   StudentProfile @relation(fields: [studentId], references: [id])
  type      String
  // Human-readable tracking reference (REQ-YYYY-####) shown to students and
  // staff instead of the internal UUID.
  referenceNo String?      @unique @map("reference_no")
  status    String         @default("awaiting_payment") // awaiting_payment | pending | under_review | approved | released | rejected
  remarks   String?

  // Payment fields
  fee                     Decimal   @default(0.00) @db.Decimal(10, 2)
  paymentStatus           String    @default("unpaid") @map("payment_status") // unpaid | paid
  paymentReference        String?   @map("payment_reference")
  // Student-submitted online payment proof (GCash/PNB), verified by Treasury
  paymentProofChannel     String?   @map("payment_proof_channel") // gcash | pnb
  paymentProofReference   String?   @map("payment_proof_reference") // GCash ref no. / PNB slip no.
  paymentProofSubmittedAt DateTime? @map("payment_proof_submitted_at")
  qrCodeUrl               String?   @map("qr_code_url")
  paymentConfirmedById    String?   @map("payment_confirmed_by_id")
  paymentConfirmedBy      User?     @relation("PaymentConfirmedBy", fields: [paymentConfirmedById], references: [id])
  paymentConfirmedAt      DateTime? @map("payment_confirmed_at")
  quoteConfirmedById      String?   @map("quote_confirmed_by_id")
  quoteConfirmedAt        DateTime? @map("quote_confirmed_at")
  quoteConfirmedBy        User?     @relation("TorQuoteConfirmedBy", fields: [quoteConfirmedById], references: [id])

  items DocumentRequestItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("document_requests")
  @@unique([paymentProofChannel, paymentProofReference], map: "document_requests_payment_proof_reference_unique")
}

model DocumentCatalogItem {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  fee        Decimal  @db.Decimal(10, 2)
  feeNote    String?  @map("fee_note")
  tat        String?
  assignedTo String?  @map("assigned_to")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  billingBasis String @default("copy") @map("billing_basis")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  items DocumentRequestItem[]

  @@map("document_catalog_items")
}

model DocumentRequestItem {
  id            String              @id @default(uuid())
  requestId     String              @map("request_id")
  request       DocumentRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  catalogItemId String              @map("catalog_item_id")
  catalogItem   DocumentCatalogItem @relation(fields: [catalogItemId], references: [id])
  type          String
  label         String
  quantity      Int                 @default(1)
  unitFee       Decimal             @map("unit_fee") @db.Decimal(10, 2)
  lineTotal     Decimal             @map("line_total") @db.Decimal(10, 2)
  billingBasis  String              @default("copy") @map("billing_basis")
  pageCount     Int?                @map("page_count")
  remarks       String?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@map("document_request_items")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  caseId    String?  @map("case_id")
  eventKey  String?  @unique @map("event_key")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ============================================================
// CHAT SYSTEM
// ============================================================

model ChatLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  message    String
  response   String
  intent     String?
  confidence Float?
  createdAt  DateTime @default(now()) @map("created_at")

  escalation  EscalationQueue?
  chatSession ChatSession?

  @@map("chat_logs")
}

model EscalationQueue {
  id         String   @id @default(uuid())
  chatId     String   @unique @map("chat_id")
  chat       ChatLog  @relation(fields: [chatId], references: [id])
  status     String   @default("pending")
  assignedTo String?  @map("assigned_to")
  assignee   User?    @relation(fields: [assignedTo], references: [id])
  resolution String?
  routingNote String? @map("routing_note")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("escalation_queue")
}

// ============================================================
// LIVE AGENT — Async Messaging
// ============================================================

model ChatSession {
  id           String         @id @default(uuid())
  studentId    String         @map("student_id")
  student      StudentProfile @relation(fields: [studentId], references: [id])
  escalationId String?        @unique @map("escalation_id")
  agentId      String?        @map("agent_id")
  agent        User?          @relation("SessionAssignedTo", fields: [agentId], references: [id])
  status       String         @default("open") // open | closed
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  studentLastViewedAt DateTime? @map("student_last_viewed_at")

  messages ChatMessage[]
  chatLog  ChatLog?      @relation(fields: [escalationId], references: [id])

  @@map("chat_sessions")
}

model ChatMessage {
  id         String      @id @default(uuid())
  sessionId  String      @map("session_id")
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId   String      @map("sender_id")
  sender     User        @relation(fields: [senderId], references: [id])
  senderRole String      @map("sender_role") // student | live_agent | registrar | dean
  content    String
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("chat_messages")
}

model ChatDailyUsage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageDate DateTime @map("usage_date") @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, usageDate])
  @@map("chat_daily_usage")
}

// Persistent, provider-wide budget for the opt-in DeepSeek adapter. This
// counter is shared by every ML service instance so restarts cannot reset the
// configured cost/token ceiling.
model DeepSeekUsageBudget {
  provider                 String   @id
  model                    String
  reservedTokens           BigInt   @default(0) @map("reserved_tokens")
  actualInputTokens        BigInt   @default(0) @map("actual_input_tokens")
  actualOutputTokens       BigInt   @default(0) @map("actual_output_tokens")
  actualTotalTokens        BigInt   @default(0) @map("actual_total_tokens")
  estimatedCostUpperUsd    Decimal  @default(0) @map("estimated_cost_upper_usd") @db.Decimal(12, 8)
  usageUnavailableCalls    Int      @default(0) @map("usage_unavailable_calls")
  providerAttempts         Int      @default(0) @map("provider_attempts")
  successfulResponses      Int      @default(0) @map("successful_responses")
  unobservedPriorRequests  Int      @default(0) @map("unobserved_prior_requests")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("deepseek_usage_budgets")
}

// ============================================================
// PHASE 3 SUPPORTING STRUCTURES
// Additive implementation-support entities required by the written
// requirements (schedule access, payment history, adviser assignment,
// advising concerns, durable knowledge base). See DEC-004.
// ============================================================

// Course schedule (P3-04). Values must come from institutional data
// (DEC-010); no defaults are invented.
model ClassSection {
  id           String       @id @default(uuid())
  courseId     String       @map("course_id")
  course       Course       @relation(fields: [courseId], references: [id])
  termId       String       @map("academic_term_id")
  term         AcademicTerm @relation(fields: [termId], references: [id])
  sectionCode  String       @map("section_code")
  instructorId String?      @map("instructor_id")
  instructor   User?        @relation("SectionInstructor", fields: [instructorId], references: [id])
  status       String       @default("active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  schedules  ClassSchedule[]
  enrollments Enrollment[]

  @@unique([courseId, termId, sectionCode])
  @@index([termId])
  @@map("class_sections")
}

model ClassSchedule {
  id             String       @id @default(uuid())
  classSectionId String       @map("class_section_id")
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  dayOfWeek      String       @map("day_of_week")
  startTime      DateTime?    @map("start_time") @db.Time
  endTime        DateTime?    @map("end_time") @db.Time
  room           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([classSectionId, dayOfWeek, startTime])
  @@map("class_schedules")
}

// Payment transaction ledger (P3-05). Money remains Decimal; no gateway.
model PaymentTransaction {
  id              String          @id @default(uuid())
  studentId       String          @map("student_id")
  student         StudentProfile  @relation(fields: [studentId], references: [id])
  academicTermId  String?         @map("academic_term_id")
  academicTerm    AcademicTerm?   @relation(fields: [academicTermId], references: [id])
  amount          Decimal         @db.Decimal(10, 2)
  paymentMethod   String?         @map("payment_method")
  referenceNumber String?         @map("reference_number")
  proofUrl        String?         @map("proof_url")
  status          String          @default("pending") // pending | verified | rejected | void
  verifiedById    String?         @map("verified_by_id")
  verifiedBy      User?           @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  paidAt          DateTime?       @map("paid_at")
  verifiedAt      DateTime?       @map("verified_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([studentId, academicTermId])
  @@map("payment_transactions")
}

// Adviser assignment (P3-06) scopes Dean/Adviser review to advisees.
model AdviserAssignment {
  id           String          @id @default(uuid())
  adviserId    String          @map("adviser_user_id")
  adviser      User            @relation("AdviserAssignments", fields: [adviserId], references: [id])
  studentId    String          @map("student_profile_id")
  student      StudentProfile  @relation(fields: [studentId], references: [id])
  academicTermId String?       @map("academic_term_id")
  academicTerm AcademicTerm?   @relation(fields: [academicTermId], references: [id])
  academicYear String?         @map("academic_year")
  status       String          @default("active")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([adviserId, studentId, academicTermId])
  @@index([studentId])
  @@map("adviser_assignments")
}

// Advising concerns (P3-07) replace the broken Exceptions placeholder.
model AdvisingConcern {
  id         String          @id @default(uuid())
  studentId  String          @map("student_profile_id")
  student    StudentProfile  @relation(fields: [studentId], references: [id])
  adviserId  String?         @map("adviser_user_id")
  adviser    User?           @relation("ConcernAdviser", fields: [adviserId], references: [id])
  category   String
  summary    String
  status     String          @default("open") // open | in_review | resolved
  notes      String?
  resolution String?
  createdAt  DateTime        @default(now()) @map("created_at")
  resolvedAt DateTime?       @map("resolved_at")

  @@index([studentId, status])
  @@map("advising_concerns")
}

// Durable knowledge base (P3-08). The ML service re-indexes from these rows
// in Phase 11. The embedding column is a pgvector type managed by raw SQL.
model KnowledgeDocument {
  id            String    @id @default(uuid())
  filename      String    @unique
  title         String
  category      String
  content       String
  version       String?
  effectiveDate DateTime? @map("effective_date") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  indexStatus   String    @default("pending") @map("index_status")
  indexError    String?   @map("index_error")
  indexedAt     DateTime? @map("indexed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  chunks KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String            @id @default(uuid())
  documentId     String            @map("document_id")
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex     Int               @map("chunk_index")
  content        String
  category       String?
  // pgvector column; not exposed through the Prisma Client.
  embedding      Unsupported("vector(384)")?
  embeddingModel String?           @map("embedding_model")
  embeddedAt     DateTime?         @map("embedded_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([documentId, chunkIndex])
  @@map("knowledge_chunks")
}

// ============================================================
// PHASE 1 — IDENTITY, SESSIONS, MFA, ONBOARDING
// ============================================================

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  tokenFamilyId    String    @map("token_family_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")

  @@index([userId])
  @@index([tokenFamilyId])
  @@map("auth_sessions")
}

model MfaChallenge {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      String    @default("login")
  otpHash      String    @map("otp_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  maxAttempts  Int       @default(5) @map("max_attempts")
  consumedAt   DateTime? @map("consumed_at")
  ipAddress    String?   @map("ip_address")

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  purpose     String    @default("password_reset")
  targetEmail String?   @map("target_email")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model StudentIdentityVerification {
  id                      String    @id @default(uuid())
  applicantEmail          String    @map("applicant_email")
  verificationType        String    @map("verification_type") // returning | alumni
  claimedStudentNumber    String?   @map("claimed_student_number")
  claimedFirstName        String    @map("claimed_first_name")
  claimedMiddleName       String?   @map("claimed_middle_name")
  claimedLastName         String    @map("claimed_last_name")
  previousName            String?   @map("previous_name")
  dateOfBirth             DateTime? @map("date_of_birth") @db.Date
  status                  String    @default("submitted") // submitted | under_review | approved | rejected | needs_info
  submittedAt             DateTime  @default(now()) @map("submitted_at")
  reviewedAt              DateTime? @map("reviewed_at")
  reviewedByUserId        String?   @map("reviewed_by_user_id")
  reviewedBy              User?     @relation("IdentityReviewedBy", fields: [reviewedByUserId], references: [id])
  matchedStudentProfileId String?   @unique @map("matched_student_profile_id")
  matchedStudentProfile   StudentProfile? @relation("MatchedStudentProfile", fields: [matchedStudentProfileId], references: [id])
  remarks                 String?
  documents               IdentityVerificationDocument[]

  @@index([status])
  @@index([applicantEmail])
  @@map("student_identity_verifications")
}

model IdentityVerificationDocument {
  id               String    @id @default(uuid())
  verificationId   String    @map("verification_id")
  verification     StudentIdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  documentType     String    @map("document_type")
  storageObjectKey String    @map("storage_object_key")
  originalFileName String    @map("original_file_name")
  mimeType         String    @map("mime_type")
  fileSize         Int       @map("file_size")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  reviewStatus     String    @default("pending") @map("review_status")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedBy       User?     @relation("VerificationDocumentReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime? @map("reviewed_at")

  @@index([verificationId])
  @@map("identity_verification_documents")
}
